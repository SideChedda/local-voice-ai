# Bare-metal note: HF_HOME defaults to /models, a Docker volume mount path
# that doesn't exist outside the container — set to a real local dir so
# llama-server can actually cache/resolve model weights.
HF_HOME=/Users/matthawkes/github/sidechedda/local-voice-ai/.models-cache

# Bare-metal note: FRONTEND_DIR is unset by default (Docker's multi-stage
# build produces frontend/out and the app only serves it when this is set).
# Build with `cd frontend && pnpm install && pnpm run build`, then point here.
FRONTEND_DIR=/Users/matthawkes/github/sidechedda/local-voice-ai/frontend/out

# Local-only LiveKit dev defaults — override LIVEKIT_URL to point at LiveKit Cloud.
LIVEKIT_URL=ws://127.0.0.1:3201
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Scarif port allocation (block 3200-3209) — stock 8080/7880/7881 collide with
# other Side Chedda services (8080 is moorcheh-onprem-server). 7882/udp is left
# on its stock port: LiveKit advertises the exact host port in ICE candidates,
# so remapping it breaks WebRTC media.
WEB_PORT=3200
LIVEKIT_BIND_PORT=3201
LIVEKIT_RTC_PORT=3202

# LLM (llama.cpp server is a managed subprocess by default)
# Bare-metal note: stock 11434/8000 collide with Sekot's Ollama and another
# local process respectively — remapped onto the Scarif 3200 block, same as
# the web/LiveKit ports above. Docker never hit this because these ports were
# container-internal only.
LLAMA_BASE_URL=http://127.0.0.1:3203/v1
LLAMA_BIND_PORT=3203
LLAMA_MODEL=gemma-4-e2b
LLAMA_MODEL_ALIAS=gemma-4-e2b
LLAMA_HF_REPO=unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
# Offline use: once the model is cached, it starts with no internet
# automatically. Force it with LLAMA_OFFLINE=1 (or LLAMA_OFFLINE=0 to always
# re-check Hugging Face), or set LLAMA_MODEL_PATH to load a local .gguf directly.
# LLAMA_OFFLINE=1
# LLAMA_MODEL_PATH=/models/gemma-4-E2B-it-qat-UD-Q4_K_XL.gguf
LLAMA_CTX_SIZE=16384
# LLAMA_N_GPU_LAYERS: CPU default is 0; the GPU overlay defaults to 999 (full
# offload). Set it here only to force a specific value in both modes.

# STT (Nemotron is the default; set STT_PROVIDER=whisper for the vox-box fallback)
STT_PROVIDER=nemotron
STT_BASE_URL=http://127.0.0.1:3204/v1
STT_BIND_PORT=3204
STT_MODEL=nemotron-speech-streaming
STT_API_KEY=no-key-needed
NEMOTRON_MODEL_NAME=nvidia/nemotron-speech-streaming-en-0.6b
NEMOTRON_MODEL_ID=nemotron-speech-streaming

# TTS (Kokoro)
TTS_BASE_URL=http://127.0.0.1:3205/v1
TTS_BIND_PORT=3205
TTS_VOICE=af_nova

# Web (FastAPI: token route + static frontend) — see WEB_PORT above (Scarif 3200 block)

# Optional Whisper fallback (STT_PROVIDER=whisper)
WHISPER_MODEL=Systran/faster-whisper-small

# Wake word: set WAKE_WORD=1 to make the agent listen only after "hey livekit".
# Detection scores are logged (log level DEBUG) — tune WAKE_WORD_THRESHOLD to
# your microphone if needed.
# WAKE_WORD=1
# WAKE_WORD_THRESHOLD=0.5
